{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.pbi/cache.abf)",
      "Read(**/.pbi/localSettings.json)",
      "Edit(.pbi/**)",
      "Edit(definition.pbir)",
      "Edit(**/*.Report/report.json)",
      "Edit(mobileState.json)",
      "Edit(semanticModelDiagramLayout.json)",
      "Edit(diagramLayout.json)"
    ],
    "ask": [
      "Edit(**/*.Report/definition/report.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-unapplied.ps1"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}